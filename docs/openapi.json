  "components": {
    "schemas": {
      "Approval": {
        "properties": {
          "period": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "title": "Period"
          },
          "amount_paise": {
            "type": "integer",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount Paise"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "period",
          "amount_paise"
        ],
        "title": "Approval"
      },
      "CalendarProposal": {
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "create",
              "edit",
              "delete"
            ],
            "title": "Operation"
          },
          "calendar_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Calendar Id"
          },
          "event_id": {
            "anyOf": [
              {
                "type": "string",
