# Copy to deploy/.env (chmod 600); never commit actual values.
DOMAIN=agent.example.com
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
DATABASE_URL=postgresql+psycopg://agent:REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD@db/agent
OWNER_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATA_KEY=REPLACE_WITH_FERNET_KEY
PREVIOUS_DATA_KEYS=

# Enable only after completing owner OAuth consent with calendar.events scope.
CALENDAR_PROVIDER=disabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
