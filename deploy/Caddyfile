{
    servers {
        timeouts {
            read_header 5s
            read_body 15s
            write 30s
            idle 60s
        }
    }
}
{$DOMAIN} {
    # No access logs: URLs may contain opaque private IDs.
    request_body {
        max_size 64KB
    }
    reverse_proxy api:8000 {
        transport http {
            dial_timeout 5s
            response_header_timeout 30s
        }
    }
    header -Server
}
